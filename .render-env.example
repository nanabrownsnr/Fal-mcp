# Render Environment Variables
# Copy these to your Render Dashboard → Environment section
# Required: All variables must be set for proper deployment

# MongoDB Atlas Connection String (without auth token in public repos)
# Get this from: https://cloud.mongodb.com/ → Atlas → Clusters → Connect
MONGODB_URI=mongodb+srv://<your-cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority&appName=YourApp

# Database name for storing API keys (without trailing _keys automatically stripped)
DATABASE_NAME=fal_mcp_keys

# Fernet encryption key - MUST be set! Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=...PASTE_GENERATED_KEY_HERE...

# Server port (REQUIRED by Render)
PORT=10000

# Host for binding (REQUIRED by Render)
HOST=0.0.0.0

# Optional: Set to production for custom headers/service id suffix
ENVIRONMENT=production

# Optional: Custom service name
FAL_MCP_NAME=fal-mcp

# Optional: Base URL for MCP manifest
PUBLIC_URL=https://your-app.render.com

# Optional: Allowed CORS origins (use asterisk or specific domains)
ALLOWED_ORIGINS=*

# Set this to enable in production after key generation
API_KEY_STORAGE_ENABLED=true

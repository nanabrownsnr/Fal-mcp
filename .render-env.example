# Copy values into the Render service's Environment page. Never commit real secrets.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DATABASE_NAME=fal_mcp
ENCRYPTION_KEY=<generated-Fernet-key>

SERVICE_ID=fal_mcp
ACCOUNT_SERVICE_URL=https://twynity-dev.api.4th-ir.com/account
ACCOUNT_SERVICE_JWKS_ENDPOINT=/.well-known/jwks.json
ACCOUNT_SERVICE_JWKS_CACHE_TTL=600
PERSONA_ID_HEADER=Persona-Id

HOST=0.0.0.0
PORT=10000
PUBLIC_URL=https://<your-render-service>.onrender.com
ALLOWED_ORIGINS=*
ENVIRONMENT=production

# Optional reporting endpoint, must be a complete URL if set.
USAGE_REPORT_ENDPOINT=
DEFAULT_FAL_MODEL=fal-ai/flux/schnell

# Optional. Set to true only after configuring a valid key and service URL.
LICENSE_ENFORCEMENT_ENABLED=false
LICENSE_KEY=
LICENSE_SERVER_BASE_URL=
LICENSE_SERVER_JWKS_ENDPOINT=/.well-known/jwks.json
LICENSE_SERVER_ACTIVATION_ENDPOINT=/api/v1/activations

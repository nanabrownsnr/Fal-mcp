# Environment variable template for Fal MCP server
# Copy this to .env and fill in actual values. Never commit populated .env

# Application identity
ENVIRONMENT=development
FAL_MCP_NAME=fal-mcp
PUBLIC_URL=http://localhost:8000

# MongoDB connection
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=fal_mcp_keys

# IMPORTANT: Generate a real encryption key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-generated-fernet-key

# Usage reporting (optional)
USAGE_REPORT_ENDPOINT=https://example.com/usage

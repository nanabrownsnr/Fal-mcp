# Fal MCP Environment Configuration
# Copy this file and fill in actual values before deploying!
# NEVER commit actual .env files to git (already excluded in .gitignore)

# ===========================================
# CORE DATABASE SETTINGS (Required for production)
# ===========================================
MONGODB_URI=<PASTE-MONGODB-ATLAS-CONNECTION-STRING-HERE>
DATABASE_NAME=fal_mcp_keys
ALLOWED_ORIGINS=*
ENVIRONMENT=development  # or production

# ===========================================
# ENCRYPTION (Generate this key once)
# Run: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" >> .env
# ===========================================
ENCRYPTION_KEY=<GENERATE-THIS-FERNET-KEY-HERE>

# ===========================================
# SERVER CONFIGURATION
# ===========================================
HOST=0.0.0.0
PORT=10000  # Use 10000 for Render, 8000 for local development

# ===========================================
# TWYNITY INTEGRATION (Optional)
# ===========================================
ACCOUNT_SERVICE_JWKS_CACHE_TTL=600
ACCOUNT_SERVICE_JWKS_ENDPOINT=/.well-known/jwks.json
ACCOUNT_SERVICE_URL=https://twynity-dev.api.4th-ir.com/account
LICENSE_KEY=F58F-AD82-ADC6-4471-5C9C-504D-9862-4764
LICENSE_SERVER_ACTIVATION_ENDPOINT=/api/v1/activations
LICENSE_SERVER_BASE_URL=https://twynity-dev.api.4th-ir.com/license-server
LICENSE_SERVER_JWKS_ENDPOINT=/.well-known/jwks.json

# ===========================================
# USAGE REPORTING (Optional)
# ===========================================
PUBLIC_URL=https://fal-mcp.onrender.com
SERVICE_ID=fal_mcp
USAGE_REPORT_ENDPOINT=/api/v1/usage_reports
